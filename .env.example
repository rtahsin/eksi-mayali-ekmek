# EkmekLab ortam değişkenleri — bu dosyayı .env.local olarak kopyalayıp doldurun.
# Gerçek değerleri ASLA repoya yazmayın.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cron uç noktaları için paylaşılan sır
CRON_SECRET=

# YZ sipariş okuyucu (Gemini)
GEMINI_API_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Müşteri e-posta kodu ile giriş (Supabase Auth'ta özel SMTP kurulunca "true")
NEXT_PUBLIC_EMAIL_LOGIN_ENABLED=false

# Site
NEXT_PUBLIC_SITE_URL=https://ekmeklab.tr

# Telegram yeni sipariş bildirimi (Faz 1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# İmzalı fiş/ekstre linkleri (Faz 3)
LINK_SIGNING_SECRET=
