rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() { return request.auth != null; }
    function isAdmin() { return isAuthenticated() && request.auth.token.isAdmin == true; }

    // Genel herkese açık dosyalar (ör. site ikonları)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ürün görselleri
    match /product-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ana sayfa arka plan görselleri
    // CORS yapılandırması Google Cloud Console'dan yapılmalı!
    match /backgrounds/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blog görselleri
    match /blog-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Kategori görselleri
    match /category-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
